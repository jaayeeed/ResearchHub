# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- MongoDB ----
# Local:   mongodb://127.0.0.1:27017/research_collab
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/research_collab?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/research_collab

# Can't reach Atlas? Set this to true to run a local MongoDB automatically
# (no install needed; data saved in server/.mongo-data, demo users auto-added).
USE_MEMORY_DB=false

# ---- Auth ----
# Use a long random string in production (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ---- CORS ----
# Comma separated list of allowed frontend origins (your Vercel URL in production)
CLIENT_ORIGIN=http://localhost:5173
